---
import { Icon } from 'astro-icon/components';
import { Bot, Braces, Terminal, Cloud, Server, Cpu, Gamepad2, Triangle, FileCode, Sparkles } from '@lucide/astro';
import SkillProgress from './SkillProgress.svelte';

export interface Skill {
  icon: string;
  name: string;
  description: string;
  level: string;
}

const { skill, headingLevel = 3 } = Astro.props as { skill: Skill; headingLevel?: 2 | 3 };
const Heading = `h${headingLevel}` as 'h2' | 'h3';

const getLevel = (level: string): 'Beginner' | 'Intermediate' | 'Advanced' => {
  const normalized = level.toLowerCase();
  if (normalized.includes('beginner') || normalized.includes('novice') || normalized.includes('learning')) {
    return 'Beginner';
  }
  if (normalized.includes('advanced') || normalized.includes('expert') || normalized.includes('pro') || normalized.includes('master') || normalized.includes('a lot')) {
    return 'Advanced';
  }
  return 'Intermediate';
};

// Icons written as "set:name" (e.g. "simple-icons:python") are Iconify icons rendered by
// astro-icon; plain names map to Lucide icons.
const skillIconMap: Record<string, any> = {
  bot: Bot,
  astro: Sparkles,
  cplusplus: Braces,
  javascript: Braces,
  linux: Terminal,
  minecraft: Gamepad2,
  netlify: Cloud,
  server: Server,
  typescript: Braces,
  vercel: Triangle,
  code: FileCode,
  terminal: Terminal,
  cpu: Cpu,
};

// Wordmark-style brand logos that are unreadable at icon size get a Lucide stand-in.
const wordmarkFallbacks: Record<string, any> = {
  'simple-icons:minecraft': Gamepad2,
};

const iconifyName = skill.icon.includes(':') && !wordmarkFallbacks[skill.icon] ? skill.icon : null;
const SkillIcon = wordmarkFallbacks[skill.icon] ?? skillIconMap[skill.icon] ?? FileCode;
---

<div class="skill-card card">
  <div class="skill-content">
    <div class="icon-wrap">
      {iconifyName ? <Icon name={iconifyName} class="skill-icon" aria-hidden="true" /> : <SkillIcon class="skill-icon" aria-hidden="true" />}
    </div>
    <div class="skill-text">
      <Heading class="skill-name">{skill.name}</Heading>
      <p class="skill-desc">{skill.description}</p>
    </div>
    <div class="skill-meter">
      <SkillProgress level={getLevel(skill.level)} />
    </div>
  </div>
</div>

<style>
  .skill-card {
    border-radius: var(--radius-lg);
    height: 100%;
  }

  .skill-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    height: 100%;
    padding: var(--spacing-lg);
  }

  .icon-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: var(--spacing-md);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    color: var(--color-accent);
  }

  .icon-wrap :global(.skill-icon) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .skill-text {
    flex-grow: 1;
    width: 100%;
  }

  .skill-name {
    font-size: var(--text-xl);
    margin-bottom: var(--spacing-sm);
  }

  .skill-desc {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
    margin-bottom: var(--spacing-md);
  }

  .skill-meter {
    width: 100%;
    margin-top: auto;
  }

  /* Phones: icon beside the text so 13 skills don't each take a full screen */
  @media (max-width: 639px) {
    .skill-content {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: var(--spacing-md);
      align-items: start;
      text-align: left;
      padding: var(--spacing-md) var(--spacing-md) var(--spacing-md) var(--spacing-md);
    }

    .icon-wrap {
      width: 2.75rem;
      height: 2.75rem;
      margin-bottom: 0;
    }

    .icon-wrap :global(.skill-icon) {
      width: 1.3rem;
      height: 1.3rem;
    }

    .skill-name {
      font-size: var(--text-lg);
      margin-bottom: 0.2rem;
    }

    .skill-desc {
      margin-bottom: var(--spacing-sm);
    }

    .skill-meter {
      grid-column: 2;
    }
  }
</style>
