---
import Card from "./Card.astro";
import { getCollection } from "astro:content";
import { thumb, achievementMeta } from "../lib/format";

export interface Props {
  /** Show only the first N (by priority); the rest are on /achievements */
  limit?: number;
}

const { limit } = Astro.props;
const achievements = await getCollection("achievements");
const sortedAchievements = [...achievements].sort(
  (a, b) => (b.data.priority || 0) - (a.data.priority || 0),
);
const shown = limit ? sortedAchievements.slice(0, limit) : sortedAchievements;
---

<section id="achievements" class="section">
  <div class="container">
    <div class="section-heading">
      <h2 class="section-title">Achievements</h2>
      {
        shown.length < sortedAchievements.length && (
          <a href="/achievements" class="text-link">All {sortedAchievements.length} achievements</a>
        )
      }
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        shown.map((achievement) => {
          const { type, title, description, date, image } = achievement.data;
          return (
            <Card className="h-full">
              <div class="achievement">
                {image && (
                  <button
                    type="button"
                    class="lightbox-trigger"
                    data-lightbox={encodeURI(image)}
                    data-alt={`Certificate: ${title}`}
                    aria-label={`View certificate: ${title}`}
                  >
                    <img src={thumb(image)} alt="" loading="lazy" decoding="async" class="w-full h-48 rounded-lg object-cover" />
                  </button>
                )}
                <h3 class="achievement-title">{title}</h3>
                <p class="achievement-meta">{achievementMeta(date, type)}</p>
                <p class="achievement-desc">{description}</p>
              </div>
            </Card>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .achievement {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--spacing-lg);
  }

  .achievement .lightbox-trigger {
    margin-bottom: var(--spacing-md);
  }

  .achievement-title {
    font-size: var(--text-xl);
    margin-bottom: 0.25rem;
  }

  .achievement-meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--spacing-sm);
  }

  .achievement-desc {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: 0;
  }
</style>
