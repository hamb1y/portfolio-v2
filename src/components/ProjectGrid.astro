---
import EntryCard from "./EntryCard.astro";
import { getCollection } from "astro:content";
import { featuredFirst } from "../lib/entries";

const projects = featuredFirst(await getCollection("projects"));
const shown = projects.slice(0, 3);
const projectContents = await getCollection("projectContent");
const projectContentIds = new Set(projectContents.map((p) => p.id.replace(/\.md$/, "")));
---

<section id="projects" class="section">
  <div class="container">
    <div class="section-heading">
      <h2 class="section-title">Projects</h2>
      {projects.length > shown.length && <a href="/projects" class="text-link">All {projects.length} projects</a>}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        shown.map((project) => (
          <EntryCard
            {...project.data}
            detailHref={projectContentIds.has(project.id) ? `/projects/${project.id}` : undefined}
          />
        ))
      }
    </div>
  </div>
</section>
