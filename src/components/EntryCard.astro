---
// Card for a project or product: used by the home page grids and the /projects and /products pages.
import Card from "./Card.astro";

export interface Props {
  title: string;
  description: string;
  tags?: string[];
  github?: string;
  live?: string;
  link?: string;
  /** Internal page with the full write-up, if there is one */
  detailHref?: string;
  featured?: boolean;
  headingLevel?: 2 | 3;
}

const { title, description, tags, github, live, link, detailHref, featured = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
// Some entries link back to this site itself; a "Visit" button for the page you're on is noise.
const externalLink = link && Astro.site && new URL(link).hostname !== Astro.site.hostname ? link : undefined;
---

<Card variant="default" className="h-full">
  <div class="flex flex-col h-full p-6">
    {featured && <span class="badge self-start mb-3">Featured</span>}
    <Heading class="text-2xl font-bold mb-3">
      {detailHref ? <a href={detailHref} class="stretched-link">{title}</a> : title}
    </Heading>
    <p class="text-text-muted mb-4 flex-grow">{description}</p>

    {
      tags && tags.length > 0 && (
        <ul class="tag-list mb-4" aria-label="Technologies">
          {tags.map((tag) => (
            <li class="badge text-xs">{tag}</li>
          ))}
        </ul>
      )
    }

    <div class="flex flex-wrap gap-3 mt-auto pt-4">
      {
        github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary flex-1 py-2 min-w-[120px]">
            GitHub
          </a>
        )
      }
      {
        live && (
          <a href={live} target="_blank" rel="noopener noreferrer" class="btn btn-primary flex-1 py-2 min-w-[120px]">
            Live Demo
          </a>
        )
      }
      {
        externalLink && !live && !github && (
          <a href={externalLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary flex-1 py-2 min-w-[120px]">
            Visit
          </a>
        )
      }
      {
        detailHref && (
          <a href={detailHref} class="btn btn-secondary flex-1 py-2 min-w-[120px]" aria-hidden="true" tabindex="-1">
            Read More
          </a>
        )
      }
    </div>
  </div>
</Card>
