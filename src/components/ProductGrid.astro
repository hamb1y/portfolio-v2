---
import EntryCard from "./EntryCard.astro";
import { getCollection } from "astro:content";
import { featuredFirst } from "../lib/entries";

const products = featuredFirst(await getCollection("products"));
const shown = products.slice(0, 3);
const productContents = await getCollection("productContent");
const productContentIds = new Set(productContents.map((p) => p.id.replace(/\.md$/, "")));
---

{
  shown.length > 0 && (
    <section id="products" class="section">
      <div class="container">
        <div class="section-heading">
          <h2 class="section-title">Products</h2>
          {products.length > shown.length && <a href="/products" class="text-link">All {products.length} products</a>}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {shown.map((product) => (
            <EntryCard
              {...product.data}
              detailHref={productContentIds.has(product.id) ? `/products/${product.id}` : undefined}
            />
          ))}
        </div>
      </div>
    </section>
  )
}
