---
import { getCollection } from "astro:content";

const siteData = await getCollection("site");
const site = siteData[0]?.data;
const sourceUrl = "https://github.com/hamb1y/portfolio-v2";
---

<footer id="contact" class="site-footer">
  <div class="container">
    {
      site?.socials && site.socials.length > 0 && (
        <div class="footer-contact">
          <h2 class="footer-heading">Contact</h2>
          <ul>
            {site.socials.map((social) => (
              <li>
                <a href={social.url} target="_blank" rel="noopener noreferrer">
                  {social.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <p class="footer-legal">
      <span>{site?.name} &copy; {new Date().getFullYear()}</span>
      <span class="sep" aria-hidden="true">|</span>
      <span>Licensed under CWSL 1.1</span>
      <span class="sep" aria-hidden="true">|</span>
      <a href={sourceUrl} target="_blank" rel="noopener noreferrer">Source</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 10;
    margin-top: clamp(4rem, 8vw, 6rem);
    padding: 2.5rem 0 3rem;
    border-top: 1px solid var(--color-divider);
    background: rgba(0, 0, 0, 0.6);
  }

  .footer-heading {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .footer-contact ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  .footer-contact a {
    display: inline-block;
    padding: 0.3rem 0;
    color: var(--color-text);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    margin: 2rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .footer-legal a {
    color: var(--color-text);
  }

  @media (max-width: 479px) {
    .footer-legal {
      flex-direction: column;
    }

    .footer-legal .sep {
      display: none;
    }
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
