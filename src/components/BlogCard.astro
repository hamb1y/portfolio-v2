---
import Card from "./Card.astro";
import { formatDate, isoDate } from "../lib/format";

export interface Props {
  slug: string;
  title: string;
  description: string;
  date: Date;
  readTime?: string;
  tags?: string[];
  image?: string;
  headingLevel?: 2 | 3;
}

const { slug, title, description, date, readTime, tags, image, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<Card className="h-full">
  <article class="post">
    {image && <img src={image} alt="" loading="lazy" decoding="async" class="post-image" />}
    <div class="post-body">
      <p class="post-meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        {readTime && <span> · {readTime} read</span>}
      </p>
      <Heading class="post-title">
        <a href={`/blog/${slug}`} class="stretched-link">{title}</a>
      </Heading>
      <p class="post-desc">{description}</p>

      {
        tags && tags.length > 0 && (
          <ul class="tag-list" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
  </article>
</Card>

<style>
  .post {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .post-image {
    width: 100%;
    height: 12rem;
    object-fit: cover;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: var(--spacing-lg);
  }

  .post-meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--spacing-sm);
  }

  .post-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--spacing-sm);
  }

  .post-desc {
    color: var(--color-text-muted);
    flex-grow: 1;
  }
</style>
