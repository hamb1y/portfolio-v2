---
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import { ClientRouter } from "astro:transitions";
import { getCollection } from "astro:content";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
}

const siteData = await getCollection("site");
const site = siteData[0]?.data;

const { title: titleProp, description, type = "website" } = Astro.props;
const pageTitle = titleProp
  ? `${titleProp} — ${site?.name ?? "Portfolio"}`
  : (site?.siteTitle ?? "Portfolio");
const pageDesc = description ?? site?.siteDesc ?? "Personal portfolio";
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://www.rishimalnad.dev");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <ClientRouter />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site?.name ?? "Portfolio"} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />

    <!-- Font -->
    <link
      rel="preload"
      href="/fonts/GoogleSans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Hide reveal sections before first paint instead of after, so they don't flash -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <!-- Starfield Background -->
    <canvas id="starfield-canvas" transition:persist aria-hidden="true"></canvas>

    <!-- Navigation -->
    <Nav />

    <!-- Main Content -->
    <main id="main" class="z-10 relative">
      <slot />
    </main>

    <Footer />

    <!-- Global Lightbox -->
    <dialog id="achievement-lightbox" class="lightbox" aria-label="Certificate">
      <img id="lightbox-img" alt="" />
    </dialog>

    <script>
      import { Starfield } from "../lib/starfield.ts";

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      // ── Starfield ──────────────────────────────────────────────
      let starfieldStarted = false;

      function initStarfield() {
        if (starfieldStarted) return; // canvas persists across navigations
        const canvas = document.getElementById(
          "starfield-canvas",
        ) as HTMLCanvasElement | null;
        if (!canvas) return;
        let sf: Starfield;
        try {
          sf = new Starfield(canvas, { starCount: 180, parallaxIntensity: 0.35 });
        } catch {
          return;
        }
        starfieldStarted = true;

        let animFrame: number | null = null;
        const loop = () => {
          sf.draw();
          animFrame = requestAnimationFrame(loop);
        };
        const start = () => {
          if (animFrame === null && !reduceMotion.matches && !document.hidden) loop();
        };
        const stop = () => {
          if (animFrame !== null) cancelAnimationFrame(animFrame);
          animFrame = null;
        };

        sf.draw();
        start();
        reduceMotion.addEventListener("change", () => (reduceMotion.matches ? stop() : start()));
        document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
        window.addEventListener(
          "pointermove",
          (e) => {
            if (e.pointerType !== "mouse") return;
            sf.updateMouse(e.clientX / window.innerWidth, e.clientY / window.innerHeight);
          },
          { passive: true },
        );
        window.addEventListener("resize", () => {
          sf.resize();
          if (animFrame === null) sf.draw();
        });
      }

      // ── Scroll reveal ──────────────────────────────────────────
      let revealObserver: IntersectionObserver | null = null;

      function setupReveal() {
        // Navigation swaps <html> attributes, so re-add the class the inline head script set.
        document.documentElement.classList.add("js");
        revealObserver?.disconnect();
        const sections = document.querySelectorAll("section.section");
        if (reduceMotion.matches || !("IntersectionObserver" in window)) {
          sections.forEach((el) => el.classList.add("revealed"));
          return;
        }
        const obs = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("revealed");
                obs.unobserve(e.target);
              }
            }),
          { threshold: 0.06, rootMargin: "0px 0px -40px 0px" },
        );
        sections.forEach((el) => obs.observe(el));
        revealObserver = obs;
      }

      // ── Lightbox ───────────────────────────────────────────────
      let lightboxAbort: AbortController | null = null;

      function setupLightbox() {
        lightboxAbort?.abort();
        lightboxAbort = new AbortController();
        const { signal } = lightboxAbort;

        const lightbox = document.getElementById("achievement-lightbox") as HTMLDialogElement | null;
        const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
        if (!lightbox || !lightboxImg || typeof lightbox.showModal !== "function") return;

        document.querySelectorAll<HTMLElement>("[data-lightbox]").forEach((trigger) => {
          trigger.addEventListener(
            "click",
            () => {
              const src = trigger.dataset.lightbox;
              if (!src) return;
              lightboxImg.src = src;
              lightboxImg.alt = trigger.dataset.alt ?? "";
              lightbox.showModal();
            },
            { signal },
          );
        });

        // Any click closes it: on the image, or on the backdrop around it.
        lightbox.addEventListener("click", () => lightbox.close(), { signal });
        lightbox.addEventListener(
          "close",
          () => {
            lightboxImg.removeAttribute("src");
            lightboxImg.alt = "";
          },
          { signal },
        );
      }

      // astro:page-load fires on the first load and after every client-side navigation.
      document.addEventListener("astro:page-load", () => {
        initStarfield();
        setupReveal();
        setupLightbox();
      });
    </script>
  </body>
</html>
