---
import Card from "./Card.astro";
import { Brain, Cpu, Gamepad2, CodeXml, BookOpen, Recycle } from "@lucide/astro";

export interface Props {
  icon: string;
  name: string;
  description: string;
  headingLevel?: 2 | 3;
}

const { icon, name, description, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";

const iconMap: Record<string, any> = {
  brain: Brain,
  cpu: Cpu,
  gamepad2: Gamepad2,
  code2: CodeXml,
  bookopen: BookOpen,
  recycle: Recycle,
};
const HobbyIcon = iconMap[icon] ?? BookOpen;
---

<Card variant="default" className="h-full">
  <div class="hobby p-6">
    <div class="hobby-icon-wrap">
      <HobbyIcon class="hobby-icon" aria-hidden="true" />
    </div>
    <div>
      <Heading class="hobby-name">{name}</Heading>
      <p class="text-text-muted mb-0">{description}</p>
    </div>
  </div>
</Card>

<style>
  .hobby {
    text-align: center;
  }

  .hobby-icon-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto var(--spacing-md);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    color: var(--color-accent);
  }

  .hobby-icon-wrap :global(.hobby-icon) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .hobby-name {
    font-size: var(--text-2xl);
    margin-bottom: var(--spacing-sm);
  }

  /* Phones: icon beside the text, like the skill cards */
  @media (max-width: 639px) {
    .hobby {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--spacing-md);
      text-align: left;
      padding: var(--spacing-md);
    }

    .hobby-icon-wrap {
      width: 2.75rem;
      height: 2.75rem;
      margin: 0;
    }

    .hobby-icon-wrap :global(.hobby-icon) {
      width: 1.3rem;
      height: 1.3rem;
    }

    .hobby-name {
      font-size: var(--text-lg);
      margin-bottom: 0.2rem;
    }
  }
</style>
