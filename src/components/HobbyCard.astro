---
import Card from "./Card.astro";
import { Brain, Cpu, Gamepad2, CodeXml, BookOpen, Recycle } from "@lucide/astro";

export interface Props {
  icon: string;
  name: string;
  description: string;
  headingLevel?: 2 | 3;
}

const { icon, name, description, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";

const iconMap: Record<string, any> = {
  brain: Brain,
  cpu: Cpu,
  gamepad2: Gamepad2,
  code2: CodeXml,
  bookopen: BookOpen,
  recycle: Recycle,
};
const HobbyIcon = iconMap[icon] ?? BookOpen;
---

<Card className="h-full">
  <div class="hobby">
    <Heading class="hobby-name">
      <HobbyIcon size={20} aria-hidden="true" />
      {name}
    </Heading>
    <p class="hobby-desc">{description}</p>
  </div>
</Card>

<style>
  .hobby {
    padding: var(--spacing-lg);
  }

  .hobby-name {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-xl);
    margin-bottom: var(--spacing-sm);
  }

  .hobby-name :global(svg) {
    flex-shrink: 0;
    color: var(--color-text-muted);
  }

  .hobby-desc {
    color: var(--color-text-muted);
    margin-bottom: 0;
  }
</style>
