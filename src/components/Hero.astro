---
import { getCollection } from "astro:content";
import { ArrowDown, Mail, ExternalLink } from "@lucide/astro";
import { Icon } from "astro-icon/components";

const siteData = await getCollection("site");
const site = siteData[0]?.data || {
  siteTitle: "Portfolio",
  name: "Your Name",
  siteDesc: "Personal portfolio showcasing skills, projects, and interests",
  socials: [],
};

// Brand logos come from simple-icons; anything else falls back to a Lucide icon.
const brandIcons: Record<string, string> = {
  github: "simple-icons:github",
  linkedin: "simple-icons:linkedin",
  twitter: "simple-icons:x",
  x: "simple-icons:x",
};
---

<div class="hero-inner">
  <h1 class="hero-name">{site.name}</h1>
  <p class="hero-desc">{site.siteDesc}</p>

  <div class="hero-cta">
    <a href="#projects" class="btn btn-primary">
      View work <ArrowDown size={18} aria-hidden="true" />
    </a>
    <a href="#contact" class="btn btn-secondary">Contact</a>
  </div>

  {
    site.socials.length > 0 && (
      <ul class="hero-socials">
        {site.socials.map((social) => {
          const brand = brandIcons[social.icon ?? ""];
          const Fallback = social.icon === "mail" ? Mail : ExternalLink;
          return (
            <li>
              <a href={social.url} target="_blank" rel="noopener noreferrer">
                {brand ? <Icon name={brand} size={18} aria-hidden="true" /> : <Fallback size={18} aria-hidden="true" />}
                <span>{social.name}</span>
              </a>
            </li>
          );
        })}
      </ul>
    )
  }
</div>

<style>
  .hero-inner {
    max-width: 760px;
  }

  .hero-name {
    font-size: clamp(2.75rem, 9vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .hero-desc {
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    color: var(--color-text-muted);
    max-width: 40ch;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .hero-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }

  .hero-cta .btn {
    min-height: 48px;
    padding-inline: 1.5rem;
  }

  .hero-socials {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .hero-socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .hero-socials a:hover {
    color: var(--color-text);
  }

  .hero-socials a:hover span {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
