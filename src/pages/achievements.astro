---
import Layout from "../components/Layout.astro";
import Card from "../components/Card.astro";
import { getCollection } from "astro:content";
import { thumb, achievementMeta } from "../lib/format";

const achievements = await getCollection("achievements");
const sortedAchievements = [...achievements].sort(
  (a, b) => (b.data.priority || 0) - (a.data.priority || 0),
);
---

<Layout title="Achievements">
  <div class="container">
    <header class="page-header">
      <h1>Achievements</h1>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {
        sortedAchievements.map((achievement) => {
          const { type, title, description, date, image } = achievement.data;
          return (
            <Card>
              <div class="achievement-row p-6">
                {image && (
                  <button
                    type="button"
                    class="lightbox-trigger achievement-thumb"
                    data-lightbox={encodeURI(image)}
                    data-alt={`Certificate: ${title}`}
                    aria-label={`View certificate: ${title}`}
                  >
                    <img src={thumb(image)} alt="" loading="lazy" decoding="async" class="rounded-lg object-cover" />
                  </button>
                )}
                <div class="achievement-body">
                  <h2>{title}</h2>
                  <p class="achievement-meta">{achievementMeta(date, type)}</p>
                  <p class="text-text-muted mb-0">{description}</p>
                </div>
              </div>
            </Card>
          );
        })
      }
    </div>
  </div>
</Layout>

<style>
  .achievement-row {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: var(--spacing-lg);
    align-items: start;
  }

  .achievement-thumb img {
    width: 88px;
    height: 88px;
  }

  .achievement-body h2 {
    font-size: clamp(1.15rem, 3.5vw, var(--text-2xl));
    margin-bottom: 0.25rem;
  }

  .achievement-meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--spacing-sm);
  }

  /* Phones: certificate on top at full width, where it can actually be read */
  @media (max-width: 479px) {
    .achievement-row {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .achievement-thumb img {
      width: 100%;
      height: 10rem;
    }
  }
</style>
