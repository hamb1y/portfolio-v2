---
import Layout from "../components/Layout.astro";
import Card from "../components/Card.astro";
import { getCollection } from "astro:content";
import { thumb } from "../lib/format";

const achievements = await getCollection("achievements");
const sortedAchievements = [...achievements].sort(
  (a, b) => (b.data.priority || 0) - (a.data.priority || 0),
);
---

<Layout title="Achievements">
  <div class="pt-32">
    <div class="container">
      <h1 class="text-5xl font-bold mb-12">Achievements & Certifications</h1>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {
          sortedAchievements.map((achievement) => {
            const { type, title, description, date, image } = achievement.data;
            return (
              <Card variant="default">
                <div class="achievement-row p-6">
                  {image && (
                    <button
                      type="button"
                      class="lightbox-trigger achievement-thumb"
                      data-lightbox={encodeURI(image)}
                      data-alt={`Certificate: ${title}`}
                      aria-label={`View certificate: ${title}`}
                    >
                      <img src={thumb(image)} alt="" loading="lazy" decoding="async" class="rounded-lg object-cover" />
                    </button>
                  )}
                  <div class="achievement-body">
                    <h2 class="text-2xl font-bold mb-2">{title}</h2>
                    <div class="flex gap-2 items-center flex-wrap">
                      {date && <span class="badge">{date.getUTCFullYear()}</span>}
                      {type && <span class="badge">{type}</span>}
                    </div>
                    <p class="text-text-muted mt-3 mb-0">{description}</p>
                  </div>
                </div>
              </Card>
            );
          })
        }
      </div>
    </div>
  </div>
</Layout>

<style>
  .achievement-row {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: var(--spacing-lg);
    align-items: start;
  }

  .achievement-thumb img {
    width: 88px;
    height: 88px;
  }

  .achievement-body :global(h2) {
    font-size: clamp(1.15rem, 3.5vw, var(--text-2xl));
  }

  /* Phones: certificate on top at full width, where it can actually be read */
  @media (max-width: 479px) {
    .achievement-row {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .achievement-thumb img {
      width: 100%;
      height: 10rem;
    }
  }
</style>
