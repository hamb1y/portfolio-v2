---
import Layout from "../components/Layout.astro";
import Hero from "../components/Hero.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import ProductGrid from "../components/ProductGrid.astro";
import SkillGrid from "../components/SkillGrid.astro";
import BlogSection from "../components/BlogSection.astro";
import AchievementsGrid from "../components/AchievementsGrid.astro";
import HobbiesGrid from "../components/HobbiesGrid.astro";
---

<Layout>
  <div class="min-h-screen">
    <!-- Hero Section -->
    <section class="section hero-section">
      <div class="container">
        <Hero />
      </div>
    </section>

    <div class="section-stack">
      <!-- Featured Products -->
      <ProductGrid />

      <!-- Featured Projects -->
      <ProjectGrid />

      <!-- Blog Posts -->
      <BlogSection />

      <!-- Skills -->
      <SkillGrid />

      <!-- Achievements -->
      <AchievementsGrid limit={6} />

      <!-- Hobbies -->
      <HobbiesGrid />
    </div>
  </div>
</Layout>

<style>
  .hero-section {
    padding-top: clamp(6.5rem, 14vw, 9rem);
    padding-bottom: 2rem;
  }

  .section-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 2vw, 1.25rem);
  }

  .section-stack :global(.section) {
    padding-top: clamp(3.5rem, 5vw, 5rem);
    padding-bottom: clamp(3.5rem, 5vw, 5rem);
  }

  /* The hero is above the fold; don't hide it behind the scroll reveal */
  :global(.js) section.section.hero-section {
    opacity: 1;
    transform: none;
  }
</style>
