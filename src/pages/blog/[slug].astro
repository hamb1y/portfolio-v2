---
import Layout from "../../components/Layout.astro";
import { getCollection, render } from "astro:content";
import { formatDate, isoDate } from "../../lib/format";

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, date, readTime, tags, image } = post.data;
const { Content } = await render(post);
---

<Layout title={title} description={description} type="article">
  <div class="container max-w-4xl">
    <article class="post">
      <header class="post-header">
        <p class="post-back"><a href="/blog" class="text-link">&larr; Blog</a></p>
        <h1>{title}</h1>
        <p class="post-meta">
          <time datetime={isoDate(date)}>{formatDate(date, true)}</time>
          {readTime && <span> · {readTime} read</span>}
        </p>
        {tags && tags.length > 0 && (
          <ul class="tag-list" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )}
      </header>

      {image && <img src={image} alt="" class="post-image" />}

      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</Layout>

<style>
  .post {
    padding-top: var(--spacing-4xl);
  }

  .post-header {
    margin-bottom: var(--spacing-2xl);
    padding-bottom: var(--spacing-xl);
    border-bottom: 1px solid var(--color-divider);
  }

  .post-back {
    margin-bottom: var(--spacing-md);
  }

  .post-header h1 {
    font-size: clamp(2rem, 6vw, var(--text-5xl));
    margin-bottom: var(--spacing-md);
  }

  .post-meta {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--spacing-sm);
  }

  .post-image {
    width: 100%;
    max-height: 24rem;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: var(--spacing-2xl);
  }
</style>
