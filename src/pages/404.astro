---
import Layout from "../components/Layout.astro";
import { navItems } from "../lib/nav";
---

<Layout title="Page not found">
  <div class="container not-found">
    <header class="page-header">
      <h1>Page not found</h1>
    </header>
    <p class="text-text-muted mb-4">There's nothing at this address. Try one of these:</p>
    <ul class="flex flex-wrap gap-3">
      {navItems.map((item) => (
        <li><a href={item.href} class="btn btn-secondary">{item.label}</a></li>
      ))}
    </ul>
  </div>
</Layout>

<style>
  .not-found ul {
    list-style: none;
  }
</style>
