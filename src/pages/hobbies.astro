---
import Layout from "../components/Layout.astro";
import HobbyCard from "../components/HobbyCard.astro";
import { getCollection } from "astro:content";

const hobbies = await getCollection("hobbies");
---

<Layout title="Hobbies">
  <div class="pt-32">
    <div class="container">
      <h1 class="text-5xl font-bold mb-12">Hobbies & Interests</h1>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {hobbies.map((hobby) => <HobbyCard {...hobby.data} headingLevel={2} />)}
      </div>
    </div>
  </div>
</Layout>
